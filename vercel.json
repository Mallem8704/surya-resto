{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://surya-resto-backend.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://surya-resto-backend.onrender.com/uploads/$1"
    },
    {
      "source": "/docs",
      "destination": "https://surya-resto-backend.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://surya-resto-backend.onrender.com/openapi.json"
    },
    {
      "source": "/health",
      "destination": "https://surya-resto-backend.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
