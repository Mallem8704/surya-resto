# ==============================================================================
# SURYA FAMILY RESTAURANT KADIRI - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this template to .env on your production server (Render / Railway / VPS / Docker):
#   cp .env.production.example .env
#
# IMPORTANT SECURITY NOTICE:
# In production (ENVIRONMENT=production), the application enforces:
# 1. Automatic rejection of default SECRET_KEY with a RuntimeError to prevent insecure deployments.
# 2. Strict CORS domain matching (regex wildcards are disabled).
# 3. In-memory sliding window rate limiting on sensitive endpoints (max 10 failed login attempts/min).
# 4. Direct NPCI Merchant UPI QR payments (Zero Razorpay fees / no third-party payment gateway).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 256-bit secret key using OpenSSL:
#   $ openssl rand -hex 32
#
# Replace the placeholder below with the generated 64-character hex string.
# WARNING: If ENVIRONMENT=production and the default test secret is used,
# the server will fail to start with a RuntimeError.
SECRET_KEY=REPLACE_WITH_OPENSSL_GENERATED_64_CHAR_HEX_KEY

# JWT Algorithm and Access Token Expiration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. PRODUCTION DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL database URI (Render, Supabase, Neon, AWS RDS, or Self-hosted VPS)
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=require
DATABASE_URL=postgresql://surya_admin:YOUR_SECURE_POSTGRES_PASSWORD@ep-surya-prod.render.com/surya_kadiri_db?sslmode=require

# Database Connection Pool Tuning (Optimized for Supabase / Cloud Postgres)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# 4. CORS & ALLOWED ORIGINS (Strict Production Whitelist)
# ------------------------------------------------------------------------------
# Comma-separated list of approved frontend domains.
# In production, wildcards (https?://.*) are strictly disabled.
ALLOWED_ORIGINS=https://suryafamilyrestaurant.com,https://www.suryafamilyrestaurant.com,https://suryafamilyrestaurant.in,https://www.suryafamilyrestaurant.in,https://surya-resto.vercel.app,https://admin.suryafamilyrestaurant.in
FRONTEND_URL=https://surya-resto.vercel.app

# ------------------------------------------------------------------------------
# 5. DIRECT MERCHANT UPI CONFIGURATION (Zero-Fee NPCI Bharat QR)
# ------------------------------------------------------------------------------
# Direct Merchant VPA for customer bill settlements at counter & table QR ordering.
# All customer payments go directly to the merchant's bank account with 0% gateway commission.
# NOTE: Third-party payment gateways (e.g. Razorpay) are omitted in favor of direct merchant UPI.
DEFAULT_UPI_VPA=9880358634@upi
MERCHANT_NAME=Surya Family Restaurant Kadiri
MERCHANT_PHONE=+919880358634
MERCHANT_CITY=Kadiri
MERCHANT_STATE=Andhra Pradesh
MERCHANT_PINCODE=515591

# ------------------------------------------------------------------------------
# 6. SLIDING WINDOW RATE LIMITING DEFAULTS
# ------------------------------------------------------------------------------
# The backend enforces in-memory sliding window rate limits per IP:
# - Sensitive Auth (/api/auth/login, /api/customer/login): Max 10 failed attempts / 60 seconds
# - Customer Registration (/api/customer/register): Max 10 attempts / 60 seconds
# - Orders (/api/orders): Max 60 orders / 60 seconds
# - Service Calls (/api/service-calls): Max 30 requests / 60 seconds
# - General API: Max 300 requests / 60 seconds
