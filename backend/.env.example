# =================================================================
# TEA TIME CAFE SAAS BACKEND CONFIGURATION
# =================================================================

# Server & App Environment
ENVIRONMENT=production
PORT=8000
SECRET_KEY=generate-a-strong-random-hex-key-here-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL
# For Render PostgreSQL: postgresql://teatime_user:password@host/teatime
# For Local Dev: sqlite:///./teatime.db
DATABASE_URL=sqlite:///./teatime.db

# Frontend URLs for CORS (comma-separated list of allowed origins)
FRONTEND_URL=https://arabic-restaurant-dineos.vercel.app,https://tea-time-application.vercel.app,http://localhost:3000

# Razorpay Payment Gateway Keys (Test or Production)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# Database Connection Pool Settings (For PostgreSQL)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
