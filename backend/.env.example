# =================================================================
# SURYA FAMILY RESTAURANT KADIRI BACKEND CONFIGURATION
# =================================================================

# Server & App Environment
ENVIRONMENT=production
PORT=8000
SECRET_KEY=surya_family_restaurant_jwt_key_kadiri_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL
# For Render PostgreSQL: postgresql://surya_user:password@host/suryadb
# For Local Dev: sqlite:///./surya_restaurant.db
DATABASE_URL=sqlite:///./surya_restaurant.db

# Frontend URLs for CORS (comma-separated list of allowed origins)
FRONTEND_URL=https://surya-resto.vercel.app,https://frontend-lake-iota-65.vercel.app,http://localhost:3000,http://localhost:3001,http://localhost:3002

# Razorpay Payment Gateway Keys (Test or Production)
RAZORPAY_KEY_ID=rzp_test_suryaKey123
RAZORPAY_KEY_SECRET=suryaSecretKey123

# Database Connection Pool Settings (For PostgreSQL)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
