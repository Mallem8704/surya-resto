# ==============================================================================
# SURYA FAMILY RESTAURANT KADIRI — VERCEL PRODUCTION ENVIRONMENT VARIABLES
# Copy and paste these into: Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================================

# 1. Live Render Backend API URL (HTTPS)
NEXT_PUBLIC_API_URL=https://surya-resto-backend.onrender.com

# 2. Server-Side Reverse Proxy / Service Binding
BACKEND_URL=https://surya-resto-backend.onrender.com

# 3. Live WebSocket URL for Real-Time Order Tracking & KDS
NEXT_PUBLIC_WS_URL=wss://surya-resto-backend.onrender.com/ws

# 4. Production Website Domain (Canonical SEO & Metadata)
NEXT_PUBLIC_SITE_URL=https://surya-resto.vercel.app

# 5. Customer Ordering Mode Feature Flags
# Online home delivery & takeaway is ACTIVE.
# Table booking & dine-in QR table ordering are set to "false" as requested.
NEXT_PUBLIC_ENABLE_TABLE_BOOKING=false
NEXT_PUBLIC_ENABLE_TABLE_ORDERING=false
